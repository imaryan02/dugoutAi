{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@agent11/shared": ["packages/shared/src/index.ts"],
      "@agent11/cricket": ["packages/cricket/src/index.ts"],
      "@agent11/agents": ["packages/agents/src/index.ts"]
    }
  }
}
