GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
# Commentary language: hinglish or english
COMMENTARY_LANGUAGE=hinglish

# Google Cloud Text-to-Speech.
# Enable API: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# Create key: https://console.cloud.google.com/apis/credentials
ENABLE_TTS=false
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here
# Two live commentary voices:
# Akash = male hype commentator, Alia = female analyst commentator.
# For COMMENTARY_LANGUAGE=english, use:
# TTS_LANGUAGE_CODE=en-IN
# TTS_AKASH_VOICE=en-IN-Wavenet-B
# TTS_ALIA_VOICE=en-IN-Wavenet-A
TTS_LANGUAGE_CODE=hi-IN
TTS_AKASH_VOICE=hi-IN-Wavenet-B
TTS_ALIA_VOICE=hi-IN-Wavenet-A
GOOGLE_APPLICATION_CREDENTIALS=

# Providers:
# - demo: Scripted 6-over hackathon thriller. No external API required.
# - cricketdata: CricketData/CricAPI provider.
# - rapidapi_cricbuzz: RapidAPI Cricbuzz Cricket API provider.
# - free_rapidapi_cricbuzz: RapidAPI Free Cricbuzz Cricket API provider.
CRICKET_PROVIDER=demo
# When CRICKET_PROVIDER=demo, this controls the optional live provider shown beside demo mode.
CRICKET_LIVE_PROVIDER=free_rapidapi_cricbuzz
# Use "ipl" for IPL-only mode, or "all" to test with any live/upcoming match.
CRICKET_MATCH_FILTER=ipl
CRICKET_API_KEY=your_cricketdata_or_cricapi_key_here
CRICKET_MATCH_ID=
CRICKET_POLL_MS=15000
# Demo super-over: wait after fan meter result before second innings starts.
SECOND_INNINGS_WAIT_MS=7000
# After a four/six, hold the next ball until the boundary stadium audio completes.
BOUNDARY_AUDIO_WAIT_MS=11000

# Required when CRICKET_PROVIDER=rapidapi_cricbuzz or free_rapidapi_cricbuzz
RAPIDAPI_KEY=your_rapidapi_key_here
# Paid Cricbuzz host: cricbuzz-cricket.p.rapidapi.com
# Free Cricbuzz host: free-cricbuzz-cricket-api.p.rapidapi.com
RAPIDAPI_HOST=free-cricbuzz-cricket-api.p.rapidapi.com
# Paid Cricbuzz only. Keep false for low quota scorecard-only mode.
CRICBUZZ_USE_COMMENTARY=false

# Required when CRICKET_PROVIDER=free_rapidapi_cricbuzz.
# Copy these path values from RapidAPI's cURL snippets if their labels differ.
FREE_CRICBUZZ_FIXTURES_PATH=cricket-schedule
FREE_CRICBUZZ_LIVE_SCORE_PATH=cricket-livescores?matchid={matchId}
FREE_CRICBUZZ_MATCH_INFO_PATH=cricket-match-info?matchid={matchId}

# Optional: comma-separated official IPL match pages to surface when RapidAPI misses same-day IPL fixtures.
IPL_FEATURED_MATCH_URLS=
CRICBUZZ_FEATURED_MATCH_URLS=

SERVER_PORT=4200
VITE_SERVER_URL=http://localhost:4200
