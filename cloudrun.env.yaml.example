# Copy this file to cloudrun.env.yaml and fill only the values you need.
# Do not commit cloudrun.env.yaml.

# Demo mode works without a live cricket API. Gemini is optional for demo mode
# because the app has local fallback commentary for demo matches.
GEMINI_API_KEY: ""
GEMINI_MODEL: "gemini-flash-latest"
COMMENTARY_LANGUAGE: "hinglish"

CRICKET_PROVIDER: "demo"
CRICKET_LIVE_PROVIDER: "free_rapidapi_cricbuzz"
CRICKET_MATCH_FILTER: "ipl"
CRICKET_MATCH_ID: ""
CRICKET_POLL_MS: "15000"
SECOND_INNINGS_WAIT_MS: "7000"
BOUNDARY_AUDIO_WAIT_MS: "11000"

# Live provider credentials. Required only when you switch away from demo mode
# or want live fixtures beside the demo match.
CRICKET_API_KEY: ""
RAPIDAPI_KEY: ""
RAPIDAPI_HOST: "free-cricbuzz-cricket-api.p.rapidapi.com"
CRICBUZZ_USE_COMMENTARY: "false"
FREE_CRICBUZZ_FIXTURES_PATH: "cricket-schedule"
FREE_CRICBUZZ_LIVE_SCORE_PATH: "cricket-livescores?matchid={matchId}"
FREE_CRICBUZZ_MATCH_INFO_PATH: "cricket-match-info?matchid={matchId}"
IPL_FEATURED_MATCH_URLS: ""
CRICBUZZ_FEATURED_MATCH_URLS: ""

# Optional Text-to-Speech.
ENABLE_TTS: "false"
GOOGLE_TTS_API_KEY: ""
TTS_LANGUAGE_CODE: "hi-IN"
TTS_AKASH_VOICE: "hi-IN-Wavenet-B"
TTS_ALIA_VOICE: "hi-IN-Wavenet-A"
